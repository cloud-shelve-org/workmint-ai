{
  "name": "workmint-ai",
  "private": true,
  "version": "0.2.0",
  "description": "A modular suite of practical AI-powered utilities",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @workmint/web",
    "build": "npm run build --workspace @workmint/web",
    "typecheck": "npm run typecheck --workspace @workmint/web"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
