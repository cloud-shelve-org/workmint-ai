{
  "name": "@workmint/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute workmint-usage --local --file=migrations/0001_usage.sql",
    "db:migrate:remote": "wrangler d1 execute workmint-usage --remote --file=migrations/0001_usage.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
